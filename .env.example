# CodeDrill runs on your Claude Code subscription by default — no API key needed.
# It authenticates through your existing `claude` login via the Claude Agent SDK.
#
# You only need this file if you'd rather use pay-as-you-go API billing instead:
# ANTHROPIC_API_KEY=sk-ant-your-key-here
#
# Optional: override the model (alias or full id; defaults to "sonnet")
# ANTHROPIC_MODEL=sonnet
