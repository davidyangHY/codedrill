{
  "name": "codedrill",
  "version": "1.0.0",
  "description": "CodeDrill - AI-powered SQL & Python interview practice",
  "author": "CodeDrill",
  "main": "electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "start": "concurrently -k -n VITE,ELECTRON -c cyan,green \"vite\" \"wait-on tcp:5273 && cross-env NODE_ENV=development electron .\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer",
    "preview": "npm run build:renderer && cross-env NODE_ENV=production electron .",
    "icon": "node scripts/make-icon.mjs",
    "pack": "npm run icon && npm run build:renderer && electron-builder --win --dir",
    "dist": "npm run icon && npm run build:renderer && electron-builder --win",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "build": {
    "appId": "com.codedrill.app",
    "productName": "CodeDrill",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodeDrill"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.272",
    "@monaco-editor/react": "^4.6.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  }
}
